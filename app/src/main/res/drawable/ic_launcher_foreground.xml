<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Outer Radiant Neon Sound Ring -->
    <path
        android:pathData="M 54,18 A 36,36 0 1,1 53.9,18 Z"
        android:strokeWidth="4.2"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="18"
                android:startY="18"
                android:endX="90"
                android:endY="90"
                android:type="linear">
                <item android:color="#FF3366" android:offset="0.0" />
                <item android:color="#7928CA" android:offset="0.5" />
                <item android:color="#00DFD8" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Sonic Groove Left Arc -->
    <path
        android:pathData="M 33,39 A 26,26 0 0,0 33,69"
        android:strokeWidth="3.2"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="30"
                android:startY="39"
                android:endX="30"
                android:endY="69"
                android:type="linear">
                <item android:color="#FF3366" android:offset="0.0" />
                <item android:color="#7928CA" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Sonic Groove Right Arc -->
    <path
        android:pathData="M 75,39 A 26,26 0 0,1 75,69"
        android:strokeWidth="3.2"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="75"
                android:startY="39"
                android:endX="75"
                android:endY="69"
                android:type="linear">
                <item android:color="#7928CA" android:offset="0.0" />
                <item android:color="#00DFD8" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Inner Dark Vinyl Disc -->
    <path
        android:pathData="M 54,54 m -18,0 a 18,18 0 1,1 36,0 a 18,18 0 1,1 -36,0"
        android:fillColor="#15082A" />

    <!-- Center Forward Playhead Prism -->
    <path
        android:pathData="M 48,44 L 64,54 L 48,64 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="48"
                android:startY="44"
                android:endX="64"
                android:endY="54"
                android:type="linear">
                <item android:color="#FFFFFF" android:offset="0.0" />
                <item android:color="#00DFD8" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Orbiting Sound Sparks -->
    <path
        android:pathData="M 18,54 m -3,0 a 3,3 0 1,1 6,0 a 3,3 0 1,1 -6,0"
        android:fillColor="#FF3366" />

    <path
        android:pathData="M 90,54 m -3,0 a 3,3 0 1,1 6,0 a 3,3 0 1,1 -6,0"
        android:fillColor="#00DFD8" />

    <path
        android:pathData="M 54,18 m -2,0 a 2,2 0 1,1 4,0 a 2,2 0 1,1 -4,0"
        android:fillColor="#FFFFFF" />

    <path
        android:pathData="M 54,90 m -2.5,0 a 2.5,2.5 0 1,1 5,0 a 2.5,2.5 0 1,1 -5,0"
        android:fillColor="#7928CA" />

</vector>

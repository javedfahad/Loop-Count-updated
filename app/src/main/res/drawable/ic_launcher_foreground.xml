<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Top Music Beam Bar (Floating Eighth Note Bridge) -->
    <path
        android:pathData="M 38,32 C 45,28 63,28 70,32"
        android:strokeWidth="3.2"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="38"
                android:startY="30"
                android:endX="70"
                android:endY="30"
                android:type="linear">
                <item android:color="#00F0FF" android:offset="0.0" />
                <item android:color="#FF007A" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Glowing Infinity Flow Ribbon (Bold Modern Loop) -->
    <!-- Left Loop: from center (54,54) down-left through (34,66), (25,54), (34,42) to center (54,54) -->
    <!-- Right Loop: from center (54,54) up-right through (74,42), (83,54), (74,66) back to center (54,54) -->
    <path
        android:pathData="M 54,54 C 44,42 37,42 32,47 C 26,53 26,61 32,67 C 37,72 44,70 54,54 C 64,38 71,36 76,41 C 82,47 82,55 76,61 C 71,66 64,66 54,54 Z"
        android:strokeWidth="5.0"
        android:strokeLineCap="round"
        android:strokeLineJoin="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="24"
                android:startY="68"
                android:endX="84"
                android:endY="40"
                android:type="linear">
                <item android:color="#00F0FF" android:offset="0.0" />
                <item android:color="#7000FF" android:offset="0.5" />
                <item android:color="#FF007A" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Secondary Inner Rhythm Glow Ribbon -->
    <path
        android:pathData="M 54,54 C 45,44 39,44 35,48 C 30,53 30,59 35,64 C 39,68 45,66 54,54 C 63,42 69,40 73,44 C 78,49 78,55 73,60 C 69,64 63,64 54,54 Z"
        android:strokeWidth="1.8"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="30"
                android:startY="54"
                android:endX="78"
                android:endY="54"
                android:type="linear">
                <item android:color="#FFFFFF" android:offset="0.0" />
                <item android:color="#00F0FF" android:offset="0.3" />
                <item android:color="#E0AAFF" android:offset="0.7" />
                <item android:color="#FFFFFF" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Center Forward Loop Triangle / Playhead -->
    <path
        android:pathData="M 50,47 L 62,54 L 50,61 Z"
        android:fillColor="#FFFFFF" />

    <!-- Left Sound Pulse Disc (Music Note Head Left) -->
    <path
        android:pathData="M 33,54 m -4,0 a 4,4 0 1,1 8,0 a 4,4 0 1,1 -8,0"
        android:fillColor="#00F0FF" />

    <!-- Right Sound Pulse Disc (Music Note Head Right) -->
    <path
        android:pathData="M 75,54 m -4,0 a 4,4 0 1,1 8,0 a 4,4 0 1,1 -8,0"
        android:fillColor="#FF007A" />

    <!-- Top Music Stem Left -->
    <path
        android:pathData="M 37,54 L 37,32"
        android:strokeWidth="2.5"
        android:strokeLineCap="round"
        android:strokeColor="#00F0FF" />

    <!-- Top Music Stem Right -->
    <path
        android:pathData="M 71,54 L 71,32"
        android:strokeWidth="2.5"
        android:strokeLineCap="round"
        android:strokeColor="#FF007A" />

    <!-- Bottom Audio Frequency Equalizer Bars -->
    <path
        android:pathData="M 44,78 L 44,83"
        android:strokeWidth="2.2"
        android:strokeLineCap="round"
        android:strokeColor="#00F0FF" />

    <path
        android:pathData="M 50,75 L 50,86"
        android:strokeWidth="2.4"
        android:strokeLineCap="round"
        android:strokeColor="#7000FF" />

    <path
        android:pathData="M 54,73 L 54,88"
        android:strokeWidth="2.8"
        android:strokeLineCap="round"
        android:strokeColor="#FFFFFF" />

    <path
        android:pathData="M 58,75 L 58,86"
        android:strokeWidth="2.4"
        android:strokeLineCap="round"
        android:strokeColor="#FF007A" />

    <path
        android:pathData="M 64,78 L 64,83"
        android:strokeWidth="2.2"
        android:strokeLineCap="round"
        android:strokeColor="#FF007A" />

</vector>

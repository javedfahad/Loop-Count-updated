<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Subtle Audiophile Groove Ring (Old-gen vinyl craftsmanship) -->
    <path
        android:pathData="M 54,54 m -27,0 a 27,27 0 1,1 54,0 a 27,27 0 1,1 -54,0"
        android:strokeWidth="0.8"
        android:strokeColor="#4F378B" />

    <path
        android:pathData="M 54,54 m -22,0 a 22,22 0 1,1 44,0 a 22,22 0 1,1 -44,0"
        android:strokeWidth="0.6"
        android:strokeColor="#381E72" />

    <!-- Center Turntable Core disc -->
    <path
        android:pathData="M 54,54 m -13.5,0 a 13.5,13.5 0 1,1 27,0 a 13.5,13.5 0 1,1 -27,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="40"
                android:startY="40"
                android:endX="68"
                android:endY="68"
                android:type="linear">
                <item android:color="#311154" android:offset="0.0" />
                <item android:color="#1A042B" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
    <path
        android:pathData="M 54,54 m -13.5,0 a 13.5,13.5 0 1,1 27,0 a 13.5,13.5 0 1,1 -27,0"
        android:strokeWidth="1.0"
        android:strokeColor="#6750A4" />

    <!-- Sophisticated Deep Purple + Lavender + Electric Violet Loop Arc (Matches App Logo & Splash Animation) -->
    <path
        android:strokeWidth="3.6"
        android:strokeLineCap="round"
        android:pathData="M 37,63 A 20,20 0 1,1 72,46">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="32"
                android:startY="65"
                android:endX="75"
                android:endY="35"
                android:type="linear">
                <item android:color="#00E5FF" android:offset="0.0" />
                <item android:color="#7C4DFF" android:offset="0.45" />
                <item android:color="#D0BCFF" android:offset="0.75" />
                <item android:color="#E040FB" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Top-Right Loop Precision Arrowhead -->
    <path
        android:pathData="M 72,36 L 80,47 L 68,48 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="68"
                android:startY="36"
                android:endX="80"
                android:endY="48"
                android:type="linear">
                <item android:color="#E040FB" android:offset="0.0" />
                <item android:color="#9C27B0" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Bottom-Left Counter Arrowhead for infinite counted loop -->
    <path
        android:pathData="M 36,68 L 27,63 L 33,56 Z"
        android:fillColor="#00E5FF" />

    <!-- Left Soundwave Bar Accent -->
    <path
        android:pathData="M 43,49 L 43,59"
        android:strokeWidth="2.2"
        android:strokeLineCap="round"
        android:strokeColor="#00E5FF" />

    <!-- Center Audiophile Playhead Apex (Pure White / Crisp Lavender) -->
    <path
        android:pathData="M 50,47 L 61,54 L 50,61 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="49"
                android:startY="47"
                android:endX="61"
                android:endY="61"
                android:type="linear">
                <item android:color="#FFFFFF" android:offset="0.0" />
                <item android:color="#EADDFF" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Right Soundwave Bar Accent -->
    <path
        android:pathData="M 66,48 L 66,60"
        android:strokeWidth="2.2"
        android:strokeLineCap="round"
        android:strokeColor="#E040FB" />

    <!-- Center Spindle Micro Dot -->
    <path
        android:fillColor="#381E72"
        android:pathData="M 54,54 m -1.2,0 a 1.2,1.2 0 1,1 2.4,0 a 1.2,1.2 0 1,1 -2.4,0" />

</vector>
